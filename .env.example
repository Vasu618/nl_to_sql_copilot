# Example environment variables for the NL-to-SQL Analytics Copilot backend.
# Copy this file to `.env` (in the same directory) and edit as needed.
# The `.env` file is loaded automatically by pydantic-settings on backend startup.
#
# All variables are OPTIONAL — sensible defaults are in backend/app/config.py.
# You only need to set variables you want to override.

# ----- Database -----
# SQLite for local dev (default). The path is relative to the project root.
ECOM_DB_URL=sqlite:///backend/data/ecommerce.db

# For production: use a Postgres URL with a READ-ONLY role.
# Example: postgresql+psycopg://readonly_user:password@host:5432/dbname
# (Don't use your admin role — defense in depth requires a read-only role.)

# Open the SQLite connection in read-only mode at the driver level.
# This is a defense-in-depth measure on top of the AST validator.
# Keep this True unless you have a specific reason to disable it.
DB_READ_ONLY=true

# ----- LLM provider -----
# "glm"  -> uses z-ai-web-dev-sdk CLI (default; what the benchmark was measured with)
# "claude" -> uses Anthropic API (architecture.md's primary choice; needs ANTHROPIC_API_KEY)
LLM_PROVIDER=glm

# Only required if LLM_PROVIDER=claude:
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Claude model to use (only relevant if LLM_PROVIDER=claude):
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ----- Safety caps (defaults are fine for local dev) -----
# Hard cap on rows returned by any executed query, regardless of what the LLM generates.
QUERY_ROW_LIMIT=1000

# Hard execution timeout (seconds) enforced at the driver level.
QUERY_TIMEOUT_SECONDS=5.0

# Maximum self-correction attempts before giving up (architecture.md mandates 3).
MAX_CORRECTION_ATTEMPTS=3
